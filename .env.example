NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/parascores?schema=public"
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://lvh.me:3000/api/auth/google/callback
CLIENT_URL=http://lvh.me:3001
CLIENT_DASHBOARD_URL=http://manage.lvh.me:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
EMAIL_FROM_ADMIN='ParaScores admin <admin@parascores.com>'
EMAIL_FROM_OLUWASEYI='Oluwaseyi - ParaScores <oluwaseyi@parascores.com>'
RESEND_API_KEY=your_resend_api_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
SENTRY_DSN=your_sentry_dsn
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_PRO_MONTHLY_PLAN=your_monthly_plan_code
PAYSTACK_PRO_YEARLY_PLAN=your_yearly_plan_code
PLATFORM_COMMISSION_PERCENT=5
PLATFORM_COMMISSION_PERCENT_PRO=3
REDIS_URL=redis://localhost:6379
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=mailto:admin@parascores.com
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
# Paragee LLM tier (free-form grounded answers). Provider-agnostic
# (OpenAI-compatible API): gemini (default) | openai | openrouter | groq | custom
# AI_PROVIDER=gemini
# AI_API_KEY=            # optional — falls back to GOOGLE_GENERATIVE_AI_API_KEY
# AI_MODEL=              # optional override — free-tier quota is PER MODEL (20/day),
                         # so pinning (e.g. gemini-3.7-flash) dodges the -latest alias's shared cap
# AI_BASE_URL=           # optional override (custom gateway/proxy)