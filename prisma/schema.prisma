generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(cuid())
  email                      String               @unique
  name                       String
  password                   String?
  role                       Role                 @default(USER)
  metadata                   Json?                @default("{}")
  created_at                 DateTime             @default(now())
  updated_at                 DateTime             @updatedAt
  picture                    String?
  emailVerificationExpiry    DateTime?
  emailVerificationToken     String?
  isEmailVerified            Boolean              @default(false)
  passwordResetExpiry        DateTime?
  passwordResetToken         String?
  organizations              OrganizationMember[]
  playing_in                 Participant[]
  player_profiles            Player[]             @relation("UserPlayerProfiles")
  teams                      Team[]               @relation("UserTeams")
  created_invites            TeamInvite[]         @relation("InviteCreator")
  followed_tournaments       TournamentFollower[]
  push_subscriptions         PushSubscription[]
  created_tournament_invites TournamentInvite[]   @relation("TournamentInviteCreator")
  payments                   Payment[]
  audit_logs                 AuditLog[]
  created_discount_codes     DiscountCode[]         @relation("DiscountCodeCreator")
}

model Organization {
  id                      String               @id @default(cuid())
  name                    String
  slug                    String               @unique
  logoUrl                 String?
  color                   String?
  phone                   String?
  isVerified              Boolean              @default(false)
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  description             String?
  paystackSubaccountCode  String?
  settlementBankCode      String?
  settlementAccountNumber String?
  settlementAccountName   String?
  payoutAccountCreatedAt  DateTime?
  instantPayouts          Boolean             @default(false)
  paystackRecipientCode   String?
  subdomain               String?              @unique
  brandConfig             Json?
  members                 OrganizationMember[]
  socials                 Social[]
  tournaments             Tournament[]
  roster                  RosterEntry[]
  pushSubscriptions       PushSubscription[]
  subscription            Subscription?
  payments                Payment[]
  pulseItems              PulseItem[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Tournament {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  start_date         DateTime
  end_date           DateTime
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  autoApprove        Boolean              @default(false)
  bannerUrl          String?
  isPractice         Boolean              @default(false)
  location           String?
  latitude           Float?
  longitude          Float?
  logoUrl            String?
  maxParticipants    Int?
  participantType    ParticipantType
  registrationClose  DateTime?
  registrationOpen   DateTime?
  scoringRules       Json
  sport              String
  timezone           String               @default("UTC")
  type               TournamentType
  visibility         Visibility           @default(PUBLIC)
  numberOfGroups     Int?
  teamsPerGroup      Int?
  customName         String?              @unique
  thirdPlaceMatch    Boolean              @default(false)
  twoLegsKnockout    Boolean              @default(false)
  isPinned           Boolean              @default(false)
  organization_id    String?
  parent_id          String?
  seasonName         String?
  doubleRoundRobin   Boolean              @default(false)
  isPremium          Boolean              @default(false)
  isPaidRegistration Boolean              @default(false)
  registrationFee    Int                  @default(0)
  tournamentPrice    Int                  @default(0)
  paymentPerTeam     Int                  @default(0)
  fixtures           Fixture[]
  groups             Group[]
  participants       Participant[]
  socials            Social[]
  sponsors           Sponsor[]
  standings          Standing[]
  team_invites       TeamInvite[]
  organization       Organization?        @relation(fields: [organization_id], references: [id])
  parent             Tournament?          @relation("TournamentSeasons", fields: [parent_id], references: [id])
  seasons            Tournament[]         @relation("TournamentSeasons")
  followers          TournamentFollower[]
  tournament_invites TournamentInvite[]
  venues             Venue[]
  payments           Payment[]
  discountCodes      DiscountCode[]
  chatMessages       ChatMessage[]

  // Esports package: tournament chat + Paragee (AI bot) + score submissions
  chatEnabled            Boolean  @default(false)
  chatRules              String?  @db.Text
  parageeBot             Json?    // { enabled, fixtures, standings, rules, quickChips, llm }
  botCalls               Int      @default(0) // Paragee call count (answered mentions)
  requiresScoreEvidence  Boolean  @default(false)
}

model TournamentFollower {
  userId       String
  tournamentId String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tournamentId])
}

model Group {
  id            String        @id @default(cuid())
  name          String
  tournament_id String
  created_at    DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  fixtures      Fixture[]
  tournament    Tournament    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  participants  Participant[]
}

model Participant {
  id                 String            @id @default(cuid())
  tournament_id      String
  user_id            String?
  team_id            String?
  customName         String?
  customShortName    String?
  seed               Int?
  status             ParticipantStatus @default(PENDING)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  groupId            String?
  logoUrl            String?
  linkCode           String?           @unique
  linkCodeExpires    DateTime?
  away_fixtures      Fixture[]         @relation("AwayTeam")
  home_fixtures      Fixture[]         @relation("HomeTeam")
  matchEvents        MatchEvent[]
  relatedMatchEvents MatchEvent[]      @relation("RelatedParticipant")
  group              Group?            @relation(fields: [groupId], references: [id])
  team               Team?             @relation(fields: [team_id], references: [id])
  tournament         Tournament        @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [user_id], references: [id])
  players            Player[]
  standings          Standing[]
  invites            TeamInvite[]
  tournamentEntry    TournamentEntry?
  resultEntries      ResultEntry[]
  scoreSubmissions   ScoreSubmission[]
  chatMessages       ChatMessage[]

  // Chat auth + typing relay look up by (tournament, user)
  @@index([tournament_id, user_id])
}

// An institution/team on an organization's roster (e.g. a university at WAUG).
// The shared identity used for cross-tournament aggregation like medal tables.
model RosterEntry {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  shortName      String?
  logoUrl        String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        TournamentEntry[]

  @@unique([organizationId, name])
}

// Links a roster entry into a specific tournament via its tournament-scoped Participant.
model TournamentEntry {
  id            String      @id @default(cuid())
  rosterEntryId String
  participantId String      @unique
  created_at    DateTime    @default(now())
  rosterEntry   RosterEntry @relation(fields: [rosterEntryId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([rosterEntryId, participantId])
}

model Fixture {
  id                  String        @id @default(cuid())
  tournament_id       String
  round               Int
  matchNumber         Int
  startTime           DateTime?
  homeTeamId          String?
  awayTeamId          String?
  homeScore           Int?
  awayScore           Int?
  status              FixtureStatus @default(SCHEDULED)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  awayPenaltyScore    Int?
  awayTeamPlaceholder String?
  groupId             String?
  homePenaltyScore    Int?
  homeTeamPlaceholder String?
  nextFixtureId       String?
  roundName           String?
  stage               FixtureStage?
  venue               String?
  homeFormation       String?
  awayFormation       String?
  lineupPositions     Json?         @default("{}")
  timerStartedAt      DateTime?
  timerElapsedSeconds Int           @default(0)
  timerIsRunning      Boolean       @default(false)
  matchDuration       Int           @default(90)
  half                MatchHalf?
  periodScores        Json?
  config              Json?
  resultEntries       ResultEntry[]
  awayTeam            Participant?  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  group               Group?        @relation(fields: [groupId], references: [id])
  homeTeam            Participant?  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  nextFixture         Fixture?      @relation("BracketProgression", fields: [nextFixtureId], references: [id])
  sourceFixtures      Fixture[]     @relation("BracketProgression")
  tournament          Tournament    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  matchEvents         MatchEvent[]
  lineupPlayers       Player[]      @relation("FixtureLineups")
  manOfTheMatchPlayerId String?
  manOfTheMatchPlayer   Player?       @relation("ManOfTheMatch", fields: [manOfTheMatchPlayerId], references: [id])
  livestreamUrl         String?
  livestreamPlatform    String?
  highlights            Highlight[]
  pulseItems            PulseItem[]
  scoreSubmissions      ScoreSubmission[]

  // Fixture lists + Paragee intents filter by tournament (+ status)
  @@index([tournament_id, status])
}

// Auto-generated fan feed cards for an event hub (the "Pulse" tab).
// Written by scoring hooks (match events, kickoff, full time, race results,
// medals) or manually by organizers (announcements). One row per
// (type, fixtureId): in-match events upsert a single per-match card.
model PulseItem {
  id             String          @id @default(cuid())
  organizationId String
  fixtureId      String?
  type           String
  payload        Json
  pinned         Boolean         @default(false)
  sortAt         DateTime        @default(now())
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fixture        Fixture?        @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  reactions      PulseReaction[]

  @@unique([type, fixtureId])
  @@index([organizationId, sortAt])
}

// Anonymous fan reactions on pulse cards — one per device per emoji.
model PulseReaction {
  id          String    @id @default(cuid())
  pulseItemId String
  deviceId    String
  emoji       String
  created_at  DateTime  @default(now())
  pulseItem   PulseItem @relation(fields: [pulseItemId], references: [id], onDelete: Cascade)

  @@unique([pulseItemId, deviceId, emoji])
  @@index([pulseItemId])
}

// Placement-based results for race/timed sports (athletics, swimming).
// A race fixture has N participants each with a value (time/distance);
// rank is derived, medals aggregate from rank 1-3 in Finals.
model ResultEntry {
  id            String      @id @default(cuid())
  fixtureId     String
  participantId String
  value         String?
  lane          Int?
  note          String?
  rank          Int?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  fixture       Fixture     @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, participantId])
}

model Team {
  id           String        @id @default(cuid())
  name         String
  shortName    String?
  created_at   DateTime      @default(now())
  logoUrl      String?
  ownerId      String?
  updated_at   DateTime      @default(now()) @updatedAt
  participants Participant[]
  owner        User?         @relation("UserTeams", fields: [ownerId], references: [id])
}

model MatchEvent {
  id                    String         @id @default(cuid())
  fixture_id            String
  participant_id        String?
  relatedParticipant_id String?
  type                  MatchEventType
  half                  MatchHalf?
  minute                Int?
  description           String?
  metadata              Json?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  playerId              String?
  relatedPlayerId       String?
  fixture               Fixture        @relation(fields: [fixture_id], references: [id], onDelete: Cascade)
  participant           Participant?   @relation(fields: [participant_id], references: [id])
  player                Player?        @relation(fields: [playerId], references: [id])
  relatedParticipant    Participant?   @relation("RelatedParticipant", fields: [relatedParticipant_id], references: [id])
  relatedPlayer         Player?        @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])
}

model Standing {
  id             String      @id @default(cuid())
  tournament_id  String
  participant_id String
  played         Int         @default(0)
  wins           Int         @default(0)
  draws          Int         @default(0)
  losses         Int         @default(0)
  goalsFor       Int         @default(0)
  goalsAgainst   Int         @default(0)
  goalDiff       Int         @default(0)
  points         Int         @default(0)
  position       Int?
  group          String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  tournament     Tournament  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, participant_id])
}

model Player {
  id                 String       @id @default(cuid())
  participantId      String
  name               String
  number             Int?
  position           String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  avatarUrl          String?
  userId             String?
  status             PlayerStatus @default(APPROVED)
  linkCode           String?      @unique
  linkCodeExpires    DateTime?
  matchEvents        MatchEvent[]
  relatedMatchEvents MatchEvent[] @relation("RelatedPlayer")
  participant        Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user               User?        @relation("UserPlayerProfiles", fields: [userId], references: [id])
  lineups            Fixture[]    @relation("FixtureLineups")
  manOfTheMatchFixtures Fixture[] @relation("ManOfTheMatch")
}

model Sponsor {
  id            String     @id @default(cuid())
  name          String
  logoUrl       String?
  websiteUrl    String?
  tournament_id String
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  description   String?
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model Social {
  id              String        @id @default(cuid())
  platform        String
  url             String
  handle          String?
  tournament_id   String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tournament      Tournament?   @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model Venue {
  id            String     @id @default(cuid())
  name          String
  tournament_id String
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id             String      @id @default(cuid())
  token          String      @unique @default(cuid())
  participant_id String
  tournament_id  String
  createdById    String
  maxUses        Int?
  usedCount      Int         @default(0)
  expiresAt      DateTime?
  isActive       Boolean     @default(true)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  createdBy      User        @relation("InviteCreator", fields: [createdById], references: [id])
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  tournament     Tournament  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model TournamentInvite {
  id            String     @id @default(cuid())
  token         String     @unique @default(cuid())
  tournament_id String
  createdById   String
  maxUses       Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  createdBy     User       @relation("TournamentInviteCreator", fields: [createdById], references: [id])
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ORGANIZER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum TournamentType {
  KNOCKOUT
  LEAGUE
  ROUND_ROBIN
  GROUP
  FRIENDLY
  HYBRID
  RACE
}

enum ParticipantType {
  INDIVIDUAL
  TEAM
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
  DISQUALIFIED
}

enum PlayerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  EXTRATIME
  NORMAL_TIME_ENDED
  COMPLETED
  CANCELLED
}

enum FixtureStage {
  GROUP_STAGE
  KNOCKOUT
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  ASSIST
  MISSED_PENALTY
  PENALTY_SAVE
}

enum MatchHalf {
  FIRST_HALF
  SECOND_HALF
  EXTRA_TIME
  PENALTY_SHOOTOUT
}

enum HighlightPlatform {
  YOUTUBE_SHORTS
  INSTAGRAM_REEL
  TIKTOK
}

model Highlight {
  id           String           @id @default(cuid())
  fixture_id   String
  platform     HighlightPlatform
  externalUrl  String
  embedUrl     String
  thumbnailUrl String?
  caption      String?
  duration     Int?
  createdById  String
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  fixture      Fixture          @relation(fields: [fixture_id], references: [id], onDelete: Cascade)

  @@index([fixture_id])
}

enum SubscriptionPlan {
  FREE
  PER_TOURNAMENT
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
  WAIVER
}

// Organizer-created codes that discount or waive a tournament's registration fee.
model DiscountCode {
  id            String       @id @default(cuid())
  code          String
  tournament_id String
  type          DiscountType
  value         Int          @default(0) // PERCENT: 1-100; FIXED: amount in kobo; WAIVER: ignored
  maxUses       Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdById   String
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  tournament    Tournament   @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  createdBy     User         @relation("DiscountCodeCreator", fields: [createdById], references: [id])

  @@unique([tournament_id, code])
  @@index([code])
}

model Subscription {
  id                       String             @id @default(cuid())
  organizationId           String             @unique
  plan                     SubscriptionPlan   @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackPlanCode         String?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelledAt              DateTime?
  trialEnd                 DateTime?
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String           @id @default(cuid())
  organizationId        String?
  tournamentId          String?
  amount                Int              // Amount in smallest currency unit (kobo/cents)
  currency              String           @default("NGN")
  status                PaymentStatus    @default(PENDING)
  paystackReference     String           @unique
  paystackTransactionId String?
  plan                  SubscriptionPlan?
  metadata              Json?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  userId                String?
  type                  String           @default("SUBSCRIPTION")
  // Instant-payout tracking (opt-in per org; only registration payments)
  payoutStatus        String? // PENDING | PROCESSING | SUCCESS | FAILED | REVERSED
  payoutTransferCode  String?
  payoutAmount        Int?
  payoutInitiatedAt   DateTime?

  organization          Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament            Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  user                  User?            @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id           String        @id @default(cuid())
  userId       String?
  endpoint     String        @unique
  p256dh       String
  auth         String
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

// ─── Esports package ──────────────────────────────────────

enum ChatAuthorType {
  USER
  ORGANIZER
  BOT
  SYSTEM
}

enum ChatCardType {
  FIXTURE
  TABLE
  STATS
  LINK
  SCORE_SUBMITTED
  SCORE_CONFIRMED
  SCORE_CONFLICT
}

// Tournament chat room messages. Public read (per tournament visibility);
// posting restricted to confirmed participants + org members; BOT/SYSTEM
// rows carry structured cards (fixture cards, score reports).
model ChatMessage {
  id            String          @id @default(cuid())
  tournamentId  String
  authorType    ChatAuthorType
  authorUserId  String?
  participantId String?
  text          String          @db.Text
  cardType      ChatCardType?
  cardPayload   Json?
  pinnedAt      DateTime?
  deletedAt     DateTime? // soft delete — organizer moderation
  replyToId     String? // quoted reply target
  createdAt     DateTime        @default(now())
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant   Participant?    @relation(fields: [participantId], references: [id], onDelete: SetNull)
  replyTo       ChatMessage?    @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       ChatMessage[]   @relation("ChatReplies")
  reactions     ChatReaction[]

  @@index([tournamentId, createdAt])
  @@index([replyToId])
}

// Emoji reactions on chat messages — one row per (message, user, emoji);
// toggled via POST /chat-messages/:id/react
model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String // plain FK-less reference to User (identity from JWT)
  emoji     String // from the fixed quick set
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

enum SubmissionStatus {
  PENDING // waiting for the opponent's entry
  MATCHED // both entries agree — auto-applied
  CONFLICT // entries disagree — organizer decides
  APPLIED // organizer verdict applied
  DISMISSED // organizer voided both entries
}

// Double-entry score reporting: each participant in a fixture submits their
// own score (with evidence for esports); matching entries auto-apply.
model ScoreSubmission {
  id            String           @id @default(cuid())
  fixtureId     String
  participantId String
  homeScore     Int
  awayScore     Int
  legs          Json? // per-leg scores for two-legged ties
  evidenceUrl   String?
  note          String?
  status        SubmissionStatus @default(PENDING)
  resolvedById  String?
  verdictNote   String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?
  fixture       Fixture          @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, participantId])
  @@index([fixtureId, status])
}
