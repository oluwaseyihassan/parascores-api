generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(cuid())
  email                      String               @unique
  name                       String
  password                   String?
  role                       Role                 @default(USER)
  metadata                   Json?                @default("{}")
  created_at                 DateTime             @default(now())
  updated_at                 DateTime             @updatedAt
  picture                    String?
  emailVerificationExpiry    DateTime?
  emailVerificationToken     String?
  isEmailVerified            Boolean              @default(false)
  passwordResetExpiry        DateTime?
  passwordResetToken         String?
  organizations              OrganizationMember[]
  playing_in                 Participant[]
  player_profiles            Player[]             @relation("UserPlayerProfiles")
  teams                      Team[]               @relation("UserTeams")
  created_invites            TeamInvite[]         @relation("InviteCreator")
  followed_tournaments       TournamentFollower[]
  created_tournament_invites TournamentInvite[]   @relation("TournamentInviteCreator")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  logoUrl     String?
  color       String?
  phone       String?
  isVerified  Boolean              @default(false)
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt
  description String?
  members     OrganizationMember[]
  socials     Social[]
  tournaments Tournament[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Tournament {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  start_date         DateTime
  end_date           DateTime
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  autoApprove        Boolean              @default(false)
  bannerUrl          String?
  location           String?
  logoUrl            String?
  maxParticipants    Int?
  participantType    ParticipantType
  registrationClose  DateTime?
  registrationOpen   DateTime?
  scoringRules       Json
  sport              String
  timezone           String               @default("UTC")
  type               TournamentType
  visibility         Visibility           @default(PUBLIC)
  numberOfGroups     Int?
  teamsPerGroup      Int?
  customName         String?              @unique
  thirdPlaceMatch    Boolean              @default(false)
  twoLegsKnockout    Boolean              @default(false)
  isPinned           Boolean              @default(false)
  organization_id    String?
  parent_id          String?
  seasonName         String?
  doubleRoundRobin   Boolean              @default(false)
  fixtures           Fixture[]
  groups             Group[]
  participants       Participant[]
  socials            Social[]
  sponsors           Sponsor[]
  standings          Standing[]
  team_invites       TeamInvite[]
  organization       Organization?        @relation(fields: [organization_id], references: [id])
  parent             Tournament?          @relation("TournamentSeasons", fields: [parent_id], references: [id])
  seasons            Tournament[]         @relation("TournamentSeasons")
  followers          TournamentFollower[]
  tournament_invites TournamentInvite[]
  venues             Venue[]
}

model TournamentFollower {
  userId       String
  tournamentId String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tournamentId])
}

model Group {
  id            String        @id @default(cuid())
  name          String
  tournament_id String
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  fixtures      Fixture[]
  tournament    Tournament    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  participants  Participant[]
}

model Participant {
  id                 String            @id @default(cuid())
  tournament_id      String
  user_id            String?
  team_id            String?
  customName         String?
  seed               Int?
  status             ParticipantStatus @default(PENDING)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  groupId            String?
  logoUrl            String?
  linkCode           String?           @unique
  linkCodeExpires    DateTime?
  away_fixtures      Fixture[]         @relation("AwayTeam")
  home_fixtures      Fixture[]         @relation("HomeTeam")
  matchEvents        MatchEvent[]
  relatedMatchEvents MatchEvent[]      @relation("RelatedParticipant")
  group              Group?            @relation(fields: [groupId], references: [id])
  team               Team?             @relation(fields: [team_id], references: [id])
  tournament         Tournament        @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [user_id], references: [id])
  players            Player[]
  standings          Standing[]
  invites            TeamInvite[]
}

model Fixture {
  id                  String        @id @default(cuid())
  tournament_id       String
  round               Int
  matchNumber         Int
  startTime           DateTime?
  homeTeamId          String?
  awayTeamId          String?
  homeScore           Int?
  awayScore           Int?
  status              FixtureStatus @default(SCHEDULED)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  awayPenaltyScore    Int?
  awayTeamPlaceholder String?
  groupId             String?
  homePenaltyScore    Int?
  homeTeamPlaceholder String?
  nextFixtureId       String?
  roundName           String?
  stage               FixtureStage?
  venue               String?
  awayTeam            Participant?  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  group               Group?        @relation(fields: [groupId], references: [id])
  homeTeam            Participant?  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  nextFixture         Fixture?      @relation("BracketProgression", fields: [nextFixtureId], references: [id])
  sourceFixtures      Fixture[]     @relation("BracketProgression")
  tournament          Tournament    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  matchEvents         MatchEvent[]
}

model Team {
  id           String        @id @default(cuid())
  name         String
  created_at   DateTime      @default(now())
  logoUrl      String?
  ownerId      String?
  updated_at   DateTime      @default(now()) @updatedAt
  participants Participant[]
  owner        User?         @relation("UserTeams", fields: [ownerId], references: [id])
}

model MatchEvent {
  id                    String         @id @default(cuid())
  fixture_id            String
  participant_id        String?
  relatedParticipant_id String?
  type                  MatchEventType
  minute                Int?
  description           String?
  metadata              Json?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  playerId              String?
  relatedPlayerId       String?
  fixture               Fixture        @relation(fields: [fixture_id], references: [id], onDelete: Cascade)
  participant           Participant?   @relation(fields: [participant_id], references: [id])
  player                Player?        @relation(fields: [playerId], references: [id])
  relatedParticipant    Participant?   @relation("RelatedParticipant", fields: [relatedParticipant_id], references: [id])
  relatedPlayer         Player?        @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])
}

model Standing {
  id             String      @id @default(cuid())
  tournament_id  String
  participant_id String
  played         Int         @default(0)
  wins           Int         @default(0)
  draws          Int         @default(0)
  losses         Int         @default(0)
  goalsFor       Int         @default(0)
  goalsAgainst   Int         @default(0)
  goalDiff       Int         @default(0)
  points         Int         @default(0)
  position       Int?
  group          String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  tournament     Tournament  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, participant_id])
}

model Player {
  id                 String       @id @default(cuid())
  participantId      String
  name               String
  number             Int?
  position           String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  avatarUrl          String?
  userId             String?
  status             PlayerStatus @default(APPROVED)
  matchEvents        MatchEvent[]
  relatedMatchEvents MatchEvent[] @relation("RelatedPlayer")
  participant        Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user               User?        @relation("UserPlayerProfiles", fields: [userId], references: [id])
}

model Sponsor {
  id            String     @id @default(cuid())
  name          String
  logoUrl       String?
  websiteUrl    String?
  tournament_id String
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  description   String?
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model Social {
  id              String        @id @default(cuid())
  platform        String
  url             String
  handle          String?
  tournament_id   String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tournament      Tournament?   @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model Venue {
  id            String     @id @default(cuid())
  name          String
  tournament_id String
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id             String      @id @default(cuid())
  token          String      @unique @default(cuid())
  participant_id String
  tournament_id  String
  createdById    String
  maxUses        Int?
  usedCount      Int         @default(0)
  expiresAt      DateTime?
  isActive       Boolean     @default(true)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  createdBy      User        @relation("InviteCreator", fields: [createdById], references: [id])
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  tournament     Tournament  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

model TournamentInvite {
  id            String     @id @default(cuid())
  token         String     @unique @default(cuid())
  tournament_id String
  createdById   String
  maxUses       Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  createdBy     User       @relation("TournamentInviteCreator", fields: [createdById], references: [id])
  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ORGANIZER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum TournamentType {
  KNOCKOUT
  LEAGUE
  ROUND_ROBIN
  GROUP
  FRIENDLY
  HYBRID
}

enum ParticipantType {
  INDIVIDUAL
  TEAM
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
  DISQUALIFIED
}

enum PlayerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum FixtureStage {
  GROUP_STAGE
  KNOCKOUT
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  ASSIST
  MISSED_PENALTY
}
