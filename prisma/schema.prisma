// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String  @id @default(cuid())
  email   String  @unique
  name    String
  picture String?

  password String? // hashed
  role     Role    @default(USER)
  metadata Json?   @default("{}")

  // Email Verification
  isEmailVerified         Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  // Password Reset
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  organizations   OrganizationMember[]
  playing_in      Participant[]
  player_profiles Player[]             @relation("UserPlayerProfiles")
  created_invites TeamInvite[]         @relation("InviteCreator")
  followed_tournaments TournamentFollower[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  logoUrl    String?
  color      String?
  phone      String?
  isVerified Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members     OrganizationMember[]
  tournaments Tournament[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           OrganizationRole @default(MEMBER)

  @@unique([organizationId, userId])
}

enum Role {
  USER
  ORGANIZER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum TournamentType {
  KNOCKOUT
  LEAGUE
  ROUND_ROBIN
  GROUP
  FRIENDLY
  HYBRID
}

enum ParticipantType {
  INDIVIDUAL
  TEAM
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
  DISQUALIFIED
}

enum PlayerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum FixtureStage {
  GROUP_STAGE
  KNOCKOUT
}

model Tournament {
  id          String  @id @default(cuid())
  name        String
  customName  String? @unique
  description String?

  // Branding
  logoUrl   String?
  bannerUrl String?

  // Logistics
  location   String?
  timezone   String     @default("UTC")
  visibility Visibility @default(PUBLIC)

  // Rules & Config
  sport           String
  type            TournamentType
  participantType ParticipantType
  scoringRules    Json

  // Registration
  maxParticipants   Int?
  registrationOpen  DateTime?
  registrationClose DateTime?
  autoApprove       Boolean   @default(false)
  isPinned          Boolean   @default(false)

  // Advanced Knockout Options
  twoLegsKnockout Boolean @default(false)
  thirdPlaceMatch Boolean @default(false)

  // Venues
  venues Venue[]

  // Group config
  numberOfGroups Int?
  teamsPerGroup  Int?

  start_date DateTime
  end_date   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization    Organization? @relation(fields: [organization_id], references: [id])
  organization_id String?

  participants Participant[]
  fixtures     Fixture[]
  standings    Standing[]
  groups       Group[]
  sponsors     Sponsor[]
  socials      Social[]
  team_invites TeamInvite[]
  followers    TournamentFollower[]
}

model TournamentFollower {
  userId        String
  tournamentId  String
  createdAt     DateTime @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@id([userId, tournamentId])
}

model Group {
  id   String @id @default(cuid())
  name String

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  participants Participant[]
  fixtures     Fixture[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Participant {
  id String @id @default(cuid())

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  user    User?   @relation(fields: [user_id], references: [id])
  user_id String?

  team    Team?   @relation(fields: [team_id], references: [id])
  team_id String?

  customName String?
  seed       Int?
  logoUrl    String?
  status     ParticipantStatus @default(PENDING)

  group   Group?  @relation(fields: [groupId], references: [id])
  groupId String?

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  home_fixtures Fixture[] @relation("HomeTeam")
  away_fixtures Fixture[] @relation("AwayTeam")

  matchEvents        MatchEvent[]
  relatedMatchEvents MatchEvent[] @relation("RelatedParticipant")
  standings          Standing[]
  players            Player[]
  invites            TeamInvite[]
}

model Fixture {
  id String @id @default(cuid())

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  group   Group?  @relation(fields: [groupId], references: [id])
  groupId String?

  stage FixtureStage?

  round       Int
  roundName   String? // e.g., "Final", "Semi Final", "Quarter Final", "Round of 16"
  matchNumber Int
  startTime   DateTime?
  venue       String?

  homeTeam            Participant? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId          String?
  homeTeamPlaceholder String? // e.g., "QF1 Winner" - shown when homeTeamId is null
  awayTeam            Participant? @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId          String?
  awayTeamPlaceholder String? // e.g., "QF2 Winner" - shown when awayTeamId is null

  // Bracket relationships (for knockout tournaments)
  nextFixture    Fixture?  @relation("BracketProgression", fields: [nextFixtureId], references: [id])
  nextFixtureId  String?
  sourceFixtures Fixture[] @relation("BracketProgression") // The two matches that feed into this fixture

  homeScore        Int?
  awayScore        Int?
  homePenaltyScore Int?
  awayPenaltyScore Int?
  status           FixtureStatus @default(SCHEDULED)

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  matchEvents MatchEvent[]
}

model Team {
  id           String        @id @default(cuid())
  name         String
  participants Participant[]
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  ASSIST
}

model MatchEvent {
  id String @id @default(cuid())

  fixture    Fixture @relation(fields: [fixture_id], references: [id], onDelete: Cascade)
  fixture_id String

  // The participant (player/team) involved in the event
  participant    Participant? @relation(fields: [participant_id], references: [id])
  participant_id String?

  // For substitutions: the player coming off
  relatedParticipant    Participant? @relation("RelatedParticipant", fields: [relatedParticipant_id], references: [id])
  relatedParticipant_id String?

  type        MatchEventType
  minute      Int? // Match minute when event occurred
  description String?
  metadata    Json? // Additional event-specific data

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  player   Player? @relation(fields: [playerId], references: [id])
  playerId String?

  relatedPlayer   Player? @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])
  relatedPlayerId String?
}

model Standing {
  id String @id @default(cuid())

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  participant_id String

  // Stats
  played       Int @default(0)
  wins         Int @default(0)
  draws        Int @default(0)
  losses       Int @default(0)
  goalsFor     Int @default(0)
  goalsAgainst Int @default(0)
  goalDiff     Int @default(0)
  points       Int @default(0)

  // Position in standings
  position Int?

  // For group stages
  group String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tournament_id, participant_id])
}

model Player {
  id String @id @default(cuid())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  user   User?   @relation("UserPlayerProfiles", fields: [userId], references: [id])
  userId String?

  name      String
  number    Int?
  position  String? // GK, DEF, MID, FWD
  avatarUrl String?
  status    PlayerStatus @default(APPROVED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  matchEvents        MatchEvent[]
  relatedMatchEvents MatchEvent[] @relation("RelatedPlayer")
}

model Sponsor {
  id   String @id @default(cuid())
  name String

  logoUrl    String?
  websiteUrl String?

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Social {
  id       String  @id @default(cuid())
  platform String // e.g., "twitter", "instagram", "facebook", "youtube", "tiktok"
  url      String
  handle   String? // e.g., "@tournamentname"

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Venue {
  id   String @id @default(cuid())
  name String

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model TeamInvite {
  id    String @id @default(cuid())
  token String @unique @default(cuid())

  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  participant_id String

  tournament    Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_id String

  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])
  createdById String

  maxUses   Int? // null = unlimited
  usedCount Int       @default(0)
  expiresAt DateTime? // null = never expires
  isActive  Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
